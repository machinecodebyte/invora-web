# Invora frontend environment template.
# Copy to `.env.local` and adjust values for your machine.
# Placeholders only - never commit real credentials or secrets.
#
# NEXT_PUBLIC_* variables are inlined into the browser bundle at build time.
# Never place secrets (API keys, tokens, passwords) behind a NEXT_PUBLIC_ prefix.

# Root origin of the Invora backend API. Absolute http(s) URL, no trailing slash.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Deployment environment label: local | development | staging | production
NEXT_PUBLIC_APP_ENV=local
